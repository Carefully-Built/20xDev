{
  "$schema": "https://knip.dev/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/providers/index.tsx",
    "tests/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "convex/**/*.{ts,tsx}", "tests/**/*.ts"],
  "ignore": ["src/components/ui/**", "src/types/**", "src/schemas/**"],
  "ignoreFiles": [
    "scripts/**",
    "sanity.cli.ts",
    "src/app/(auth)/actions/auth.ts",
    "src/app/(auth)/actions/index.ts",
    "src/app/(auth)/actions/oauth.ts",
    "src/app/(auth)/actions/password.ts",
    "src/app/dashboard/_components/data-table.tsx",
    "src/hooks/use-mobile.ts",
    "src/hooks/use-widget-token.ts",
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "@dnd-kit/core",
    "@dnd-kit/modifiers",
    "@dnd-kit/sortable",
    "@dnd-kit/utilities",
    "@tanstack/react-table",
    "date-fns",
    "react-day-picker",
    "recharts",
    "shadcn",
    "tw-animate-css",
    "vaul",
    "postcss",
    "tailwindcss",
    "eslint-config-next",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "@eslint/eslintrc",
    "@hookform/resolvers",
    "@workos-inc/authkit-nextjs",
    "react-hook-form",
    "zxcvbn",
    "@carefully-built/saas-kit",
    "@fullcalendar/core",
    "@fullcalendar/daygrid",
    "@fullcalendar/interaction",
    "@fullcalendar/react",
    "@fullcalendar/timegrid",
    "@radix-ui/react-slot",
    "@tiptap/extension-link",
    "@tiptap/extension-table",
    "@tiptap/extension-table-cell",
    "@tiptap/extension-table-header",
    "@tiptap/extension-table-row",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@xyflow/react",
    "papaparse",
    "react-country-flag",
    "react-phone-number-input",
    "@types/zxcvbn",
    "@types/papaparse",
  ],
}
